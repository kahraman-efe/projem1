@model List<WebApplication4.DAL.Entities.Feature>
@{
    Layout = "_AdminLayout";
}
<div class="top-bar">
    <h1>Ana Sayfa Başlıkları (Feature)</h1>
    <a href="/Feature/Create" class="btn">+ Yeni Ekle</a>
</div>
<table>
    <tr>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>İşlem</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td><a class="delete-link" href="/Feature/Delete/@item.FeatureId" onclick="return confirm('Silmek istediğine emin misin?')">Sil</a></td>
        </tr>
    }
</table>