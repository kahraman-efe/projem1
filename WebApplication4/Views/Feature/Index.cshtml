@model List<WebApplication4.DAL.Entities.Feature>
@{
    Layout = "_AdminLayout";
}
<div class="top-bar">
    <h1>Ana Sayfa Başlıkları (Feature)</h1>
    <a href="/Feature/Create" class="btn">+ Yeni Ekle</a>
</div>
<table>
    <tr>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>İşlem</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>
                <form method="post" action="/Feature/Delete/@item.FeatureId" onsubmit="return confirm('Silmek istediğine emin misin?')" class="delete-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="delete-link">Sil</button>
                </form>
            </td>
        </tr>
    }
</table>