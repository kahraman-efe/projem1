@model List<WebApplication4.DAL.Entities.Portfolio>
@{
    Layout = "_AdminLayout";
}
<div class="top-bar">
    <h1>Projeler</h1>
    <a href="/Portfolio/Create" class="btn">+ Yeni Proje Ekle</a>
</div>
<table>
    <tr>
        <th>Görsel</th>
        <th>Başlık</th>
        <th>Alt Başlık</th>
        <th>Link</th>
        <th>İşlem</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td><img class="thumb" src="@item.ImageURL" /></td>
            <td>@item.Title</td>
            <td>@item.Subtitle</td>
            <td><a href="@item.URL" target="_blank">@item.URL</a></td>
            <td>
                <form method="post" action="/Portfolio/Delete/@item.PortfolioId" onsubmit="return confirm('Silmek istediğine emin misin?')" class="delete-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="delete-link">Sil</button>
                </form>
            </td>
        </tr>
    }
</table>