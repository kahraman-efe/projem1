@model List<WebApplication4.DAL.Entities.Portfolio>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Projeler";
}
<div class="top-bar">
    <h1>Projeler</h1>
    <a href="/Portfolio/Create" class="btn"><i class="bi bi-plus-lg"></i> Yeni Proje Ekle</a>
</div>
<table>
    <tr>
        <th>Görsel</th>
        <th>Başlık</th>
        <th>Alt Başlık</th>
        <th>Durum</th>
        <th>Link</th>
        <th>İşlem</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td><img class="thumb" src="@item.ImageURL" alt="" onerror="this.style.visibility='hidden'" /></td>
            <td>@item.Title</td>
            <td>@item.Subtitle</td>
            <td>
                @if (item.Status == WebApplication4.DAL.Entities.ProjectStatus.Tamamlandi)
                {
                    <span class="pill pill--ok"><i class="bi bi-check2-circle"></i> Tamamlandı</span>
                }
                else
                {
                    <span class="pill pill--warn"><i class="bi bi-hourglass-split"></i> Geliştiriliyor</span>
                }
            </td>
            <td><a href="@item.URL" target="_blank">@item.URL</a></td>
            <td>
                <form method="post" action="/Portfolio/Delete/@item.PortfolioId" onsubmit="return confirm('Silmek istediğine emin misin?')" class="delete-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="delete-link">Sil</button>
                </form>
            </td>
        </tr>
    }
</table>