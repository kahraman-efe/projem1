@model WebApplication4.DAL.Entities.Portfolio
@{
    Layout = "_AdminLayout";
}
<h1>Yeni Proje Ekle</h1>
<div class="form-box">
    <form method="post" action="/Portfolio/Create" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <ul>
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }
        <label>Başlık</label>
        <input type="text" name="Title" required />

        <label>Alt Başlık</label>
        <input type="text" name="Subtitle" />

        <label>Görsel</label>
        <div id="dropZone" class="drop-zone">
            <div id="dropZoneText">
                <p>📁 Görsel yüklemek için tıklayın veya sürükleyin</p>
                <small>PNG, JPG, WEBP — maks. 5MB</small>
            </div>
            <img id="previewImg" style="display:none; max-height:120px; margin-top:10px;" />
        </div>
        <input type="file" name="ImageFile" id="fileInput" accept="image/*" style="display:none" />

        <label>Proje Linki</label>
        <input type="text" name="URL" />

        <label>Açıklama</label>
        <textarea name="Description" rows="4"></textarea>

        <button type="submit">Kaydet</button>
    </form>
</div>

<style>
    .drop-zone {
        border: 2px dashed #ccc;
        border-radius: 8px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.15s;
    }

        .drop-zone.dragover {
            border-color: #333;
            background: #f8f8f8;
        }
</style>

@section Scripts {
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const previewImg = document.getElementById('previewImg');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('dragover');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('dragover');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                onizlemeGoster(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) {
                onizlemeGoster(fileInput.files[0]);
            }
        });

        function onizlemeGoster(dosya) {
            const okuyucu = new FileReader();
            okuyucu.onload = (e) => {
                previewImg.src = e.target.result;
                previewImg.style.display = 'block';
            };
            okuyucu.readAsDataURL(dosya);
        }
    </script>
}