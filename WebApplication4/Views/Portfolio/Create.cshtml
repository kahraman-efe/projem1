@model WebApplication4.DAL.Entities.Portfolio
@using WebApplication4.DAL.Entities
@{
    Layout = "_AdminLayout";
    var isEdit = Model != null && Model.PortfolioId > 0;
    ViewData["Title"] = isEdit ? "Projeyi Düzenle" : "Yeni Proje";
    var action = isEdit ? $"/Portfolio/Edit/{Model!.PortfolioId}" : "/Portfolio/Create";
    var hasImage = !string.IsNullOrWhiteSpace(Model?.ImageURL);
}
<a href="/Portfolio/Index" class="btn btn--ghost btn--sm" style="margin-bottom:16px"><i class="bi bi-arrow-left"></i> Listeye dön</a>
<h1>@(isEdit ? "Projeyi Düzenle" : "Yeni Proje Ekle")</h1>
<div class="form-box">
    <form method="post" action="@action" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        <label for="Title">Başlık</label>
        <input type="text" id="Title" name="Title" value="@Model?.Title" maxlength="200" required />

        <label for="Subtitle">Alt Başlık <small style="color:var(--text-faint)">(isteğe bağlı)</small></label>
        <input type="text" id="Subtitle" name="Subtitle" value="@Model?.Subtitle" maxlength="200" placeholder="Ör: ASP.NET Core MVC" />

        <label>Görsel @if (isEdit) { <small style="color:var(--text-faint)">(değiştirmek istemiyorsan boş bırak)</small> }</label>
        <div id="dropZone" class="drop-zone">
            <div id="dropZoneText" style="@(hasImage ? "display:none" : "")">
                <p>📁 Görsel yüklemek için tıklayın veya sürükleyin</p>
                <small>PNG, JPG, WEBP — maks. 5MB</small>
            </div>
            <img id="previewImg" src="@(hasImage ? Model!.ImageURL : "")" alt="" style="@(hasImage ? "" : "display:none;") max-height:140px; margin-top:10px;" />
        </div>
        <input type="file" name="ImageFile" id="fileInput" accept="image/*" style="display:none" />

        <label for="URL">Proje Linki <small style="color:var(--text-faint)">(isteğe bağlı)</small></label>
        <input type="text" id="URL" name="URL" value="@Model?.URL" maxlength="500" placeholder="siteadi.com, https://github.com/kullanici/proje, ..." inputmode="url" autocomplete="off" />
        <small style="display:block;margin-top:6px;color:var(--text-faint)">Her türlü web adresi olur; başına https:// yazmazsan otomatik eklenir.</small>

        <label for="Status">Durum</label>
        <select id="Status" name="Status">
            <option value="Tamamlandi" selected="@(Model?.Status == ProjectStatus.Tamamlandi)">Tamamlandı</option>
            <option value="Gelisiyor" selected="@(Model?.Status == ProjectStatus.Gelisiyor)">Geliştiriliyor</option>
        </select>

        <label for="Description">Açıklama <small style="color:var(--text-faint)">(isteğe bağlı)</small></label>
        <textarea id="Description" name="Description" rows="4" maxlength="2000">@Model?.Description</textarea>

        <button type="submit"><i class="bi bi-check2"></i> @(isEdit ? "Değişiklikleri Kaydet" : "Kaydet")</button>
    </form>
</div>

<style>
    .drop-zone {
        border: 2px dashed #ccc;
        border-radius: 8px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.15s;
    }

        .drop-zone.dragover {
            border-color: #333;
            background: #f8f8f8;
        }
</style>

@section Scripts {
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const previewImg = document.getElementById('previewImg');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('dragover');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('dragover');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                onizlemeGoster(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) {
                onizlemeGoster(fileInput.files[0]);
            }
        });

        function onizlemeGoster(dosya) {
            const okuyucu = new FileReader();
            okuyucu.onload = (e) => {
                previewImg.src = e.target.result;
                previewImg.style.display = 'block';
                document.getElementById('dropZoneText').style.display = 'none';
            };
            okuyucu.readAsDataURL(dosya);
        }
    </script>
}