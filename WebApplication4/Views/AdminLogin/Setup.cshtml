@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>İlk Admin Kurulumu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin-auth.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="/hola-master/favicon.svg">
</head>
<body>
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

    <main class="card">
        <div class="logo"><i class="bi bi-rocket-takeoff-fill"></i></div>
        <h1>İlk admin hesabı</h1>
        <p class="sub">
            Bu sayfa yalnızca hiç admin yokken görünür.
            Hesabı oluşturduktan sonra otomatik olarak kapanır.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error" role="alert"><i class="bi bi-exclamation-circle"></i> @ViewBag.Error</div>
        }

        <form method="post" asp-action="Setup" asp-controller="AdminLogin">
            <div class="field">
                <label for="username">Kullanıcı Adı</label>
                <div class="input-wrap">
                    <i class="bi bi-person"></i>
                    <input type="text" id="username" name="username" placeholder="Kullanıcı adınız" autocomplete="username" autofocus required />
                </div>
            </div>
            <div class="field">
                <label for="password">Şifre</label>
                <div class="input-wrap">
                    <i class="bi bi-key"></i>
                    <input type="password" id="password" name="password" placeholder="En az 8 karakter" minlength="8" autocomplete="new-password" required />
                    <button type="button" class="toggle-pass" data-target="password" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
                </div>
            </div>
            <div class="field">
                <label for="confirmPassword">Şifre (Tekrar)</label>
                <div class="input-wrap">
                    <i class="bi bi-key-fill"></i>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Şifreyi tekrar girin" minlength="8" autocomplete="new-password" required />
                    <button type="button" class="toggle-pass" data-target="confirmPassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
                </div>
            </div>
            <button type="submit" class="btn-login">Hesabı Oluştur <i class="bi bi-check2"></i></button>
        </form>
    </main>

    <script>
        document.querySelectorAll('.toggle-pass').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.target);
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
                btn.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
            });
        });
    </script>
</body>
</html>
