@using WebApplication4.DAL.Context
@inject MyPortfolioContext Db
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // Okunmamış mesaj sayısı (veritabanına ulaşılamazsa menüde rozet gösterilmez)
    int unread = 0;
    try { unread = Db.Messages.Count(m => !m.IsRead); } catch { }

    var userName = User.Identity?.Name ?? "Admin";
    var initial = userName.Length > 0 ? userName.Substring(0, 1) : "A";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Panel";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@pageTitle · Admin Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="/hola-master/favicon.svg">
</head>
<body>
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

    <div class="shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/Admin/Index">
                <span class="brand__logo">KE</span>
                <span class="brand__text">
                    <strong>Kahraman Efe</strong>
                    <small>Yönetim Paneli</small>
                </span>
            </a>

            <nav class="nav" aria-label="Admin menüsü">
                <a href="/Admin/Index" class="@Active("Admin")"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                <a href="/Message/Index" class="@Active("Message")">
                    <i class="bi bi-envelope-paper-heart"></i> Mesajlar
                    @if (unread > 0)
                    {
                        <span class="nav__badge">@unread</span>
                    }
                </a>

                <div class="nav__group">İçerik</div>
                <a href="/Feature/Index" class="@Active("Feature")"><i class="bi bi-stars"></i> Ana Sayfa Başlığı</a>
                <a href="/About/Index" class="@Active("About")"><i class="bi bi-person-badge"></i> Hakkımda</a>
                <a href="/Portfolio/Index" class="@Active("Portfolio")"><i class="bi bi-kanban"></i> Projeler</a>
                <a href="/Skill/Index" class="@Active("Skill")"><i class="bi bi-lightning-charge"></i> Yetenekler</a>
                <a href="/Education/Index" class="@Active("Education")"><i class="bi bi-mortarboard"></i> Eğitim</a>
                <a href="/Experience/Index" class="@Active("Experience")"><i class="bi bi-briefcase"></i> Deneyimler</a>
                <a href="/Testimonial/Index" class="@Active("Testimonial")"><i class="bi bi-chat-quote"></i> Referanslar</a>
                <a href="/Statistic/Index" class="@Active("Statistic")"><i class="bi bi-bar-chart-line"></i> İstatistikler</a>

                <div class="nav__group">Ayarlar</div>
                <a href="/SocialMedia/Index" class="@Active("SocialMedia")"><i class="bi bi-share"></i> Sosyal Medya</a>
                <a href="/Contact/Index" class="@Active("Contact")"><i class="bi bi-geo-alt"></i> İletişim Bilgileri</a>
            </nav>

            <div class="sidebar__footer">
                <a href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Siteyi Gör</a>
                <a href="/AdminLogin/Logout" class="logout"><i class="bi bi-power"></i> Çıkış Yap</a>
            </div>
        </aside>
        <div class="backdrop" id="backdrop"></div>

        <main class="main">
            <header class="topbar">
                <button type="button" class="topbar__menu" id="menuToggle" aria-label="Menüyü aç" aria-controls="sidebar"><i class="bi bi-list"></i></button>
                <div class="topbar__crumb">Panel / <b>@pageTitle</b></div>
                <div class="topbar__spacer"></div>
                <div class="topbar__clock" id="clock"></div>
                <div class="avatar" title="@userName">@initial</div>
            </header>

            @RenderBody()
        </main>
    </div>

    <script>
        (function () {
            // Mobil menü
            var body = document.body;
            document.getElementById('menuToggle').addEventListener('click', function () { body.classList.toggle('nav-open'); });
            document.getElementById('backdrop').addEventListener('click', function () { body.classList.remove('nav-open'); });

            // Canlı saat
            var clock = document.getElementById('clock');
            function tick() {
                clock.textContent = new Date().toLocaleString('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
            }
            tick(); setInterval(tick, 30000);

            // Tabloları kart içine al, boş tablolara bilgi satırı ekle
            document.querySelectorAll('.main table').forEach(function (table) {
                if (!table.parentElement.classList.contains('table-card')) {
                    var wrap = document.createElement('div');
                    wrap.className = 'table-card';
                    table.parentNode.insertBefore(wrap, table);
                    wrap.appendChild(table);
                }
                var rows = table.querySelectorAll('tr');
                if (rows.length === 1) {
                    var cols = rows[0].children.length;
                    var tr = document.createElement('tr');
                    tr.innerHTML = '<td class="empty" colspan="' + cols + '"><i class="bi bi-inbox"></i>Henüz kayıt yok. Yeni bir tane ekleyerek başla!</td>';
                    rows[0].parentNode.appendChild(tr);
                }
            });

            // Sil butonlarına ikon
            document.querySelectorAll('.delete-link').forEach(function (el) {
                el.insertAdjacentHTML('afterbegin', '<i class="bi bi-trash3"></i>');
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
