@model WebApplication4.DAL.Entities.Contact
@{
    var sent = TempData["ContactSuccess"] as bool?;
    var title = string.IsNullOrWhiteSpace(Model?.Title) ? "Benimle iletişime geçin" : Model!.Title;
}

<section id="contact" class="s-contact target-section">

    <div class="overlay"></div>

    <div class="row narrow section-intro">
        <div class="col-full">
            <h3>İletişim</h3>
            <h2>@title</h2>
            @if (!string.IsNullOrWhiteSpace(Model?.Description))
            {
                <p class="lead">@Model.Description</p>
            }
        </div>
    </div>

    <div class="row contact__main">
        <div class="col-eight tab-full contact__form">

            @if (sent == true)
            {
                <div class="form-alert form-alert--success" role="status">
                    <i class="im im-check-mark-circle" aria-hidden="true"></i>
                    Mesajınız iletildi, teşekkürler! En kısa sürede dönüş yapacağım.
                </div>
            }
            else if (sent == false)
            {
                <div class="form-alert form-alert--error" role="alert">
                    <i class="im im-warning" aria-hidden="true"></i>
                    Mesajınız gönderilemedi. Lütfen bilgileri kontrol edip tekrar deneyin.
                </div>
            }

            <form name="contactForm" id="contactForm" method="post" action="/Contact/SendMessage">
                <fieldset>
                    <div class="form-field">
                        <label for="contactName" class="sr-only">Adınız</label>
                        <input name="contactName" type="text" id="contactName" placeholder="Adınız" minlength="2" maxlength="200" required aria-required="true" autocomplete="name" class="full-width">
                    </div>
                    <div class="form-field">
                        <label for="contactEmail" class="sr-only">E-posta</label>
                        <input name="contactEmail" type="email" id="contactEmail" placeholder="E-posta" maxlength="200" required aria-required="true" autocomplete="email" class="full-width">
                    </div>
                    <div class="form-field">
                        <label for="contactSubject" class="sr-only">Konu</label>
                        <input name="contactSubject" type="text" id="contactSubject" placeholder="Konu (isteğe bağlı)" maxlength="200" class="full-width">
                    </div>
                    <div class="form-field">
                        <label for="contactMessage" class="sr-only">Mesajınız</label>
                        <textarea name="contactMessage" id="contactMessage" placeholder="Mesajınız" rows="8" maxlength="4000" required aria-required="true" class="full-width"></textarea>
                    </div>
                    <div class="form-field">
                        <button type="submit" class="full-width btn--primary">Gönder</button>
                        <div class="submit-loader">
                            <div class="text-loader">Gönderiliyor...</div>
                            <div class="s-loader">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>

        <div class="col-four tab-full contact__infos">
            @if (!string.IsNullOrWhiteSpace(Model?.Phone1))
            {
                <h4 class="h06">Telefon</h4>
                <p><a href="tel:@Model.Phone1.Replace(" ", "")">@Model.Phone1</a></p>
            }

            @if (!string.IsNullOrWhiteSpace(Model?.Email1))
            {
                <h4 class="h06">E-posta</h4>
                <p><a href="mailto:@Model.Email1">@Model.Email1</a></p>
            }

            @if (!string.IsNullOrWhiteSpace(Model?.Address))
            {
                <h4 class="h06">Adres</h4>
                <p>@Model.Address</p>
            }
        </div>
    </div>

</section>
