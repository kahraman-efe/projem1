@model List<WebApplication4.DAL.Entities.SocialMedia>
@if (Model != null && Model.Count > 0)
{
    <ul class="home-social">
        @foreach (var item in Model)
        {
            <li>
                <a href="@item.Url" target="_blank" rel="noopener" aria-label="@item.Title">
                    <i class="im im-@item.Icon" aria-hidden="true"></i><span>@item.Title</span>
                </a>
            </li>
        }
    </ul>
}
