@model WebApplication4.DAL.Entities.About

<section id="about" class="s-about target-section">
    <div class="row narrow section-intro has-bottom-sep">
        <div class="col-full text-center">
            <h3>Hakkımda</h3>
            <h1>@Model?.Title</h1>
            <p>@Model?.SubDescription</p>
        </div>
    </div>
    <div class="row about-content">
        <div class="col-six tab-full left">
            <h3>Kendi hakkımda bilgiler</h3>
            <p>@Model?.Details</p>
        </div>
        @await Component.InvokeAsync("SkillComponent")
    </div> <!-- end about-content -->
    <div class="row about-content about-content--buttons">
        <div class="col-six tab-full left">
            <a href="~/files/cv Kahraman_Efe_Erden.pdf" download class="btn btn--primary full-width">CV'mi indir</a>
        </div>
        <div class="col-six tab-full right">
            <form action="/Contact/SendQuickMessage" method="POST">
                <input type="email" name="contactEmail" placeholder="E-mail" required>
                <textarea name="contactMessage" placeholder="Mesaj" required></textarea>
                <button type="submit" class="btn full-width">Bana Yazın</button>
            </form>
        </div>
    </div> <!-- end about-content buttons -->
    @await Component.InvokeAsync("EducationComponent")
    <!-- end about-content timeline -->
</section>