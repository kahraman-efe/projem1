@model WebApplication4.DAL.Entities.About
@{
    var quickSent = TempData["QuickSuccess"] as bool?;
}

<section id="about" class="s-about target-section">
    <div class="row narrow section-intro has-bottom-sep">
        <div class="col-full text-center">
            <h3>Hakkımda</h3>
            <h2>@(string.IsNullOrWhiteSpace(Model?.Title) ? "Ben kimim?" : Model!.Title)</h2>
            @if (!string.IsNullOrWhiteSpace(Model?.SubDescription))
            {
                <p class="lead">@Model.SubDescription</p>
            }
        </div>
    </div>

    <div class="row about-content">
        <div class="col-six tab-full left">
            <h3>Kendi hakkımda</h3>
            <p>@Model?.Details</p>
        </div>
        @await Component.InvokeAsync("SkillComponent")
    </div>

    <div class="row about-content about-content--buttons">
        <div class="col-six tab-full left">
            <div class="about-card">
                <h4 class="about-card__title">Özgeçmişim</h4>
                <p>Eğitim, deneyim ve projelerimin tamamı tek bir PDF dosyasında.</p>
                <a href="~/files/cv%20Kahraman_Efe_Erden.pdf" download="Kahraman_Efe_Erden_CV.pdf" class="btn btn--primary full-width">
                    <i class="im im-download" aria-hidden="true"></i> CV'mi indir
                </a>
            </div>
        </div>
        <div class="col-six tab-full right">
            <form class="about-card quick-form" action="/Contact/SendQuickMessage" method="post">
                <h4 class="about-card__title">Hızlı mesaj</h4>

                @if (quickSent == true)
                {
                    <div class="form-alert form-alert--success" role="status">Mesajınız iletildi, teşekkürler!</div>
                }
                else if (quickSent == false)
                {
                    <div class="form-alert form-alert--error" role="alert">Mesaj gönderilemedi. E-posta adresinizi kontrol edip tekrar deneyin.</div>
                }

                <label for="quickEmail" class="sr-only">E-posta</label>
                <input id="quickEmail" type="email" name="contactEmail" placeholder="E-posta adresiniz" maxlength="200" autocomplete="email" class="full-width" required>
                <label for="quickMessage" class="sr-only">Mesaj</label>
                <textarea id="quickMessage" name="contactMessage" placeholder="Kısa mesajınız" rows="3" maxlength="4000" class="full-width" required></textarea>
                <button type="submit" class="btn full-width">
                    <i class="im im-paperplane" aria-hidden="true"></i> Bana yazın
                </button>
                <p class="form-legal form-legal--light">
                    Verileriniz <a href="/kvkk" target="_blank">KVKK Aydınlatma Metni</a> kapsamında yalnızca yanıt vermek için işlenir.
                </p>
            </form>
        </div>
    </div>

    @await Component.InvokeAsync("EducationComponent")
</section>
