@model List<WebApplication4.DAL.Entities.Education>
@if (Model != null && Model.Count > 0)
{
    <div class="row about-content about-content--education">
        <div class="col-full text-center">
            <h3>Eğitim Bilgilerim</h3>
        </div>
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="col-six tab-full @(i % 2 == 0 ? "left" : "right")">
                <h5>@Model[i].SchoolName</h5>
                <p>@Model[i].FieldOfStudy &middot; @Model[i].Date</p>
            </div>
        }
    </div> <!-- end about-content education -->
}