
<head>

    <!--- basic page needs
    ================================================== -->
    <meta charset="utf-8">
    <title>@ViewData["HeadTitle"]</title>
    <meta name="description" content="@ViewData["HeadDescription"]">
    <meta name="author" content="Kahraman Efe">

    <!-- mobile specific metas
    ================================================== -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Open Graph / sosyal medya paylaşım
    ================================================== -->
    <meta property="og:type" content="profile">
    <meta property="og:title" content="@ViewData["HeadTitle"]">
    <meta property="og:description" content="@ViewData["HeadDescription"]">
    <meta property="og:url" content="@ViewData["HeadUrl"]">
    <meta property="og:locale" content="tr_TR">
    <meta property="og:site_name" content="Kahraman Efe · Erden Yazılım">
    <meta property="og:image" content="https://kahramanefe.com.tr/hola-master/images/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Kahraman Efe Erden — Yazılım Geliştirici, Erden Yazılım">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://kahramanefe.com.tr/hola-master/images/og-image.jpg">

    <!-- CSS
    ================================================== -->
    <link rel="stylesheet" href="~/hola-master/css/base.css">
    <link rel="stylesheet" href="~/hola-master/css/vendor.css">
    <link rel="stylesheet" href="~/hola-master/css/main.css" asp-append-version="true">
    <link rel="stylesheet" href="~/hola-master/css/custom.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devicon@2.16.0/devicon.min.css">

    <!-- script
    ================================================== -->
    <script src="~/hola-master/js/modernizr.js"></script>
    <script src="~/hola-master/js/pace.min.js"></script>

    <link rel="icon" type="image/png" href="/hola-master/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/hola-master/favicon.svg">
    <link rel="shortcut icon" href="/hola-master/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/hola-master/apple-touch-icon.png">
    <link rel="manifest" href="/hola-master/site.webmanifest">

    <link rel="canonical" href="@ViewData["HeadUrl"]">

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Person",
          "name": "Kahraman Efe",
          "url": "https://kahramanefe.com.tr",
          "jobTitle": "Yazılım Geliştirici",
          "sameAs": [
            "https://github.com/kahraman-efe",
            "https://www.linkedin.com/in/kahraman-efe-erden-677387378/"
          ]
        }
    </script>
</head>
