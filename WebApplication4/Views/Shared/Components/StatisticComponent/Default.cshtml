@model List<WebApplication4.DAL.Entities.Statistic>

<section id="stats" class="s-stats">
    <div class="row block-1-4 block-tab-1-2 block-mob-full stats">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="col-block stats__col @(i == 2 ? "stats__col--highlight" : "")">
                @if (i == 2)
                {
                    <div class="stats__upsign">
                        <a href="#"><i class="im im-arrow-up" aria-hidden="true"></i></a>
                    </div>
                }
                <div class="stats__count">
                    @Model[i].Count
                </div>
                <h4>@Model[i].Title</h4>
            </div>
        }
    </div>
</section>