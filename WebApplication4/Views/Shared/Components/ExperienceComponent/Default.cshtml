@model List<WebApplication4.DAL.Entities.Experience>

<div class="row about-content about-content--timeline">

    <div class="col-full text-center">
        <h3>İş Tecrübelerim</h3>
    </div>

    <div class="col-six tab-full left">
        <div class="timeline">
            @for (int i = 0; i < Model.Count; i++)
            {
                if (i % 2 == 0)
                {
                    <div class="timeline__block">
                        <div class="timeline__bullet"></div>
                        <div class="timeline__header">
                            <p class="timeline__timeframe">@Model[i].Date</p>
                            <h3>@Model[i].Head</h3>
                            <h5>@Model[i].Title</h5>
                        </div>
                        <div class="timeline__desc">
                            <p>@Model[i].Description</p>
                        </div>
                    </div> <!-- end timeline__block -->
                }
            }
        </div> <!-- end timeline -->
    </div> <!-- end left -->

    <div class="col-six tab-full right">
        <div class="timeline">
            @for (int i = 0; i < Model.Count; i++)
            {
                if (i % 2 != 0)
                {
                    <div class="timeline__block">
                        <div class="timeline__bullet"></div>
                        <div class="timeline__header">
                            <p class="timeline__timeframe">@Model[i].Date</p>
                            <h3>@Model[i].Head</h3>
                            <h5>@Model[i].Title</h5>
                        </div>
                        <div class="timeline__desc">
                            <p>@Model[i].Description</p>
                        </div>
                    </div> <!-- end timeline__block -->
                }
            }
        </div> <!-- end timeline -->
    </div> <!-- end right -->

</div>