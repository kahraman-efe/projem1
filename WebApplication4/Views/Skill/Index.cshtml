@model List<WebApplication4.DAL.Entities.Skill>
@{
    Layout = "_AdminLayout";
}
<div class="top-bar">
    <h1>Yetenekler</h1>
    <a href="/Skill/Create" class="btn">+ Yeni Yetenek Ekle</a>
</div>
<table>
    <tr>
        <th>Başlık</th>
        <th>Değer</th>
        <th>İşlem</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Value</td>
            <td>
                <form method="post" action="/Skill/Delete/@item.SkillId" onsubmit="return confirm('Silmek istediğine emin misin?')" class="delete-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="delete-link">Sil</button>
                </form>
            </td>
        </tr>
    }
</table>